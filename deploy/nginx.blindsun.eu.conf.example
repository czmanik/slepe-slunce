# /etc/nginx/sites-available/blindsun.eu
#
# Tento blok je vedle stávající konfigurace slepeslunce.cz.
# Obě domény záměrně míří do stejného Laravel public adresáře.
# Aplikace podle Host hlavičky sama nastaví české nebo anglické rozhraní.

server {
    listen 80;
    listen [::]:80;
    server_name blindsun.eu www.blindsun.eu;

    return 301 https://www.blindsun.eu$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.blindsun.eu;

    root /opt/notm/apps/slepeslunce/public;
    index index.php;
    charset utf-8;
    client_max_body_size 20M;

    # Certifikát už je vystavený. Cesty ověřte příkazem:
    # sudo certbot certificates
    ssl_certificate /etc/letsencrypt/live/blindsun.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blindsun.eu/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/blindsun.eu.access.log;
    error_log /var/log/nginx/blindsun.eu.error.log warn;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* { deny all; }

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
}

# HTTPS na holé doméně musí mít platný certifikát ještě před přesměrováním.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name blindsun.eu;
    ssl_certificate /etc/letsencrypt/live/blindsun.eu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/blindsun.eu/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    return 301 https://www.blindsun.eu$request_uri;
}
