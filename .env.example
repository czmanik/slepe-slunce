APP_NAME="Slepé Slunce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://slepeslunce.cz
APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ
APP_TIMEZONE=Europe/Prague

ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slepe_slunce
DB_USERNAME=slepe_slunce
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_URL=null
MAIL_HOST=smtp.seznam.cz
MAIL_PORT=587
MAIL_USERNAME="news@slepeslunce.cz"
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="news@slepeslunce.cz"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_EHLO_DOMAIN=slepeslunce.cz

# Volitelné: první správce pro databázový seeder.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SHOP_TESTING_ENABLED=false
SHOP_SELLER_NAME="Heaven's Mill CZ s.r.o."
SHOP_SELLER_ICO=04561929
SHOP_SELLER_DIC=
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true
COMGATE_GATEWAY_METHOD=CARD_ALL

# Comgate CloudPOS pro terminál N80 Move. Přístup povolte v Comgate pro IP adresu serveru.
COMGATE_TERMINAL_ENABLED=false
COMGATE_TERMINAL_LOGIN=
COMGATE_TERMINAL_SECRET=
