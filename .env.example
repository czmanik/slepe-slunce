APP_NAME="Slepé Slunce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://slepeslunce.cz
APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ
APP_TIMEZONE=Europe/Prague

ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT=12

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slepe_slunce
DB_USERNAME=slepe_slunce
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="redakce@slepeslunce.cz"
MAIL_FROM_NAME="${APP_NAME}"

# Volitelné: první správce pro databázový seeder.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
