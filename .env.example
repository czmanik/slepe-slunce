APP_NAME="Slepé Slunce"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://slepeslunce.cz
APP_LOCALE=cs
APP_FALLBACK_LOCALE=cs
APP_FAKER_LOCALE=cs_CZ
APP_TIMEZONE=Europe/Prague

ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT=12

# Google Cloud Translation API: pouze na serveru, nikdy ve veřejném JavaScriptu.
GOOGLE_TRANSLATE_API_KEY=
GOOGLE_TRANSLATE_TIMEOUT=20

LOG_CHANNEL=stack
LOG_STACK=single
SENTRY_LOG_LEVEL=warning
SENTRY_LARAVEL_DSN=
SENTRY_ENABLE_LOGS=true
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slepe_slunce
DB_USERNAME=slepe_slunce
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_FROM_ADDRESS="news@slepeslunce.cz"
MAIL_FROM_NAME="${APP_NAME}"

# Volitelné: první správce pro databázový seeder.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

SHOP_DOMAIN=shop.slepeslunce.cz
SHOP_SELLER_NAME="Heaven's Mill CZ s.r.o."
SHOP_SELLER_ICO=04561929
SHOP_SELLER_DIC=
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true

MAILCHIMP_API_KEY=
MAILCHIMP_SERVER=
MAILCHIMP_LIST_ID=

# Skript projektu v Sentry: Settings > Projects > Client Keys (DSN) > Loader Script.
# Příklad: https://js.sentry-cdn.com/VAŠE_VEŘEJNÉ_ID.min.js
SENTRY_BROWSER_LOADER_URL=
SENTRY_BROWSER_TRACES_SAMPLE_RATE=0.1
